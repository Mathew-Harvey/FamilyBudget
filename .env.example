# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres. On Render the Web Service and the Cron Job use the INTERNAL
# database url, your own machine uses the EXTERNAL one. src/db.js turns SSL on
# automatically for any host that is not localhost, so one value works in both
# places with no code change.
DATABASE_URL=postgresql://user:password@host/dbname

# A SEPARATE database, used only by `npm test`. The test helper refuses to run
# when this is missing or equal to DATABASE_URL, so tests cannot reach live
# data. Local only: never set this on Render.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/familybudget_test

# Redbark API key, from Settings > API & MCP. Needs the connections:read and
# data:read scopes. Read from the environment only, never logged, never sent
# to the browser.
REDBARK_API_KEY=rbk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redbark API release, sent as the Redbark-Version header on every request.
# The API rejects requests without it.
REDBARK_API_VERSION=2026-10-01.wattle

# Long random string. Generate one with: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=change-me

# "production" on Render. Enables secure cookies and quiet logging.
NODE_ENV=development

# Email alerts, Stage 5. Nothing is sent until these are set and alerts are
# switched on in the app. Any provider that takes a JSON POST works: the default
# url is Resend, Postmark and friends just need a different EMAIL_API_URL.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
ALERT_FROM=budget@yourdomain.example

# Periodic analysis and predictive budgeting through the Claude API. Analysis is
# off until this is set and it is switched on in the app, because it sends
# financial figures to Anthropic. Account numbers are never sent, including the
# ones banks bury inside transaction descriptions.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# The household's own clock. Every calendar date the app works out comes from
# this, and Postgres is told the same zone on every connection. Render runs in
# UTC, which is yesterday in Perth from 4pm to midnight, so leaving it unset on
# a server puts the pay period and the runway a day out for a third of the day.
HOUSEHOLD_TIMEZONE=Australia/Perth

# How far back the everyday spend rate looks. scripts/backtest.js measures this
# against what really happened next rather than assuming it: 120 days beat 60 by
# about 40 percent. Change it with a reason, and rerun the backtest.
SPEND_WINDOW_DAYS=120
